# RepoSensei 销售构建配置 —— 复制为 deploy/.env 后填写（deploy/.env 绝不入库！）
#
#   cp deploy/.env.example deploy/.env

# ── 授权密钥（必填，正式销售前）────────────────────────────────────────────
# 用途：构建 App 时编译进校验逻辑 + 生成激活码时签名，两者必须是同一个值。
# 生成一个强随机串：openssl rand -hex 24
# ⚠️ 丢失后无法再给已售出的 App 发码；请在密码管理器备份。
RS_LICENSE_SECRET=

# ── Apple 签名/公证（可选；不签名也能卖，买家按「买家必读」右键打开即可）────
# 需要 Apple Developer 账号（$99/年）。填了以下值 build 脚本可扩展接入签名。
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# APPLE_ID=you@example.com
# APPLE_PASSWORD=app-specific-password
# APPLE_TEAM_ID=TEAMID
