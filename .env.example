# Copy this to .env.local and fill in your own values. .env.local is
# .gitignored — never commit real keys.
#
# Two modes, pick ONE:
#
# (A) Anthropic native
# ANTHROPIC_API_KEY=sk-ant-...
#
# (B) OpenAI-compatible proxy / reverse proxy
# OPENAI_BASE_URL=https://your-proxy.example.com/v1
# OPENAI_API_KEY=your-token-here
#
# Override default models (optional):
# RS_SUMMARY_MODEL=claude-sonnet-4-6
# RS_CHAT_MODEL=claude-haiku-4-5-20251001
