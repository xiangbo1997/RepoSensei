{
  "name": "reposensei",
  "private": true,
  "version": "0.1.1",
  "description": "Your AI repo sensei — understand any GitHub project in 15 minutes.",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
